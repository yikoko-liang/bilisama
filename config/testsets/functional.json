{
  "id": "functional",
  "title": "功能验收",
  "description": "覆盖当前 MVP 的语音、直播事件、调度、开关和安全控制。事件走正式 Assembly；语音类用例会提示你配合说话。",
  "cases": [
    {
      "id": "func.voice.basic",
      "group": "语音实时对话",
      "title": "连续两轮语音对话",
      "operator": "运行后对麦克风说“我在调一个图像工作流”，AI 回答后追问“你刚才建议的第二步是什么？”",
      "expected": [
        "两轮话都被识别并回答",
        "第二轮能接住第一轮上下文",
        "没有无故自言自语"
      ],
      "duration_s": 30,
      "events": []
    },
    {
      "id": "func.voice.event-shared-context",
      "group": "语音实时对话",
      "title": "语音与直播事件共享上下文但不混淆说话人",
      "operator": "运行后先对麦克风说“我们现在在测试 ComfyUI 采样器”。等待 5 秒的弹幕回复完成后，再说“接着刚才观众的问题，你自己的判断呢？”",
      "expected": [
        "弹幕回复能利用此前主播语音中的 ComfyUI 上下文",
        "弹幕里的“你”默认指主播，助手 不把观众误认成主播",
        "后续主播语音能承接刚才的弹幕和事件回复",
        "助手 直接回答自己的判断，不让主播再去问主播"
      ],
      "duration_s": 30,
      "events": [
        {
          "at_s": 5,
          "kind": "danmaku",
          "viewer": {
            "uid": 109,
            "name": "节点研究员"
          },
          "text": "你为什么把这个采样器放在这里？助手 你怎么看？",
          "route": "direct"
        }
      ]
    },
    {
      "id": "func.voice.interrupt",
      "group": "语音实时对话",
      "title": "主播开口打断 AI",
      "operator": "弹幕触发长回答。听到 AI 开口约 1 秒后说“停，先告诉我最关键的一步”。",
      "expected": [
        "旧回答立即停止播放",
        "对话页出现 playback.clear 对应的中断",
        "AI 改答主播的新问题"
      ],
      "duration_s": 18,
      "events": [
        {
          "at_s": 0,
          "kind": "danmaku",
          "viewer": {
            "uid": 101,
            "name": "阿强"
          },
          "text": "请从原理、安装、配置、排错四个方面详细介绍 ComfyUI 工作流",
          "route": "direct"
        }
      ]
    },
    {
      "id": "func.voice.noise",
      "group": "语音实时对话",
      "title": "键盘和桌面噪声抗干扰",
      "operator": "运行后连续敲键盘、移动鼠标并轻敲桌面 10 秒，不要说话；最后清楚说“现在回答我，今天测试什么？”",
      "expected": [
        "纯噪声期间不触发有效回答",
        "最后一句人声能被识别",
        "回答内容与最后一句一致"
      ],
      "duration_s": 20,
      "events": []
    },
    {
      "id": "func.voice.bgm",
      "group": "语音实时对话",
      "title": "小音量 BGM 边界",
      "operator": "以日常直播的小音量播放有人声 BGM，沉默 8 秒，再正常说“帮我总结刚才的进度”。",
      "expected": [
        "BGM 不应频繁触发对话",
        "主播说话仍可识别",
        "若把歌词当主播话，记录为失败并保留日志"
      ],
      "duration_s": 18,
      "events": []
    },
