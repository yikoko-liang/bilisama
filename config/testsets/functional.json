    {
      "id": "func.entry.vip",
      "group": "进房欢迎",
      "title": "VIP 进房与重复进房",
      "operator": "无需说话，同一位舰长会在 3 秒内重复进房。",
      "expected": ["第一次按名字欢迎", "短时间重复事件不会再次欢迎", "欢迎语知道对方是舰长"],
      "duration_s": 9,
      "events": [
        {"at_s": 0, "kind": "vip_enter", "viewer": {"uid": 311, "name": "老船长", "guard_level": "captain"}},
        {"at_s": 3, "kind": "vip_enter", "viewer": {"uid": 311, "name": "老船长", "guard_level": "captain"}}
      ]
    },
    {
      "id": "func.gift.tiers",
      "group": "礼物答谢",
      "title": "免费、中额和大额礼物分级",
      "operator": "无需说话，依次注入免费礼物、1000 元礼物和 10000 元礼物。",
      "expected": ["免费礼物不抢占正在说的话", "中额和大额礼物答谢强度有区别", "金额和用户名不说错"],
      "duration_s": 16,
      "events": [
        {"at_s": 0, "kind": "gift", "viewer": {"uid": 401, "name": "小星星"}, "gift": {"gift_id": 1, "name": "小花花", "num": 1, "coin_type": "silver", "total_coin": 0}},
        {"at_s": 5, "kind": "gift", "viewer": {"uid": 402, "name": "中杯拿铁"}, "value_cny": 1000, "gift": {"gift_id": 2, "name": "能量石", "num": 1, "coin_type": "gold", "total_coin": 1000000}},
        {"at_s": 10, "kind": "gift", "viewer": {"uid": 403, "name": "榜一大哥"}, "value_cny": 10000, "gift": {"gift_id": 3, "name": "星际飞船", "num": 1, "coin_type": "gold", "total_coin": 10000000}}
      ]
