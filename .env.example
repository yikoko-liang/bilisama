# BiliSama 用到的环境变量。复制成你自己的启动环境，密钥永不入库。
# 本地 LLM 凭据放 path.sh（已在 .gitignore 里），格式见下。

# --- 真服务器测试（官方三段 pipe，见计划 §17.2） ---
# path.sh 的内容（三行，source 即用）：
#   export base_url="https://.../v4/"     # OpenAI 兼容 chat-completions 端点
#   export api_key="..."                  # 只走环境变量，不进任何配置文件
#   export model_name="..."               # 模型名

# --- 模型下载 ---
# HuggingFace 走国内镜像（SmartTurn 判停模型、Qwen3-TTS 权重）：
# HF_ENDPOINT=https://hf-mirror.com

# --- s2s 相关路径（都有默认值，一般不用设） ---
# BILISAMA_S2S_ROOT=../speech-to-speech         # 上游检出目录
# BILISAMA_S2S_VENV=~/.local/share/bilisama/engines/s2s
# BILISAMA_S2S_CONFIG=config/s2s/bilisama-s2s.json

# --- 门禁 ---
# BILISAMA_GATE_REQUIRE_INTEGRATION=1   # CI 上设：没装 s2s 就直接判失败

# --- 直播凭据（阶段 3 起用，届时经系统钥匙串，不走明文） ---
# BILI_SESSDATA=
# DASHSCOPE_API_KEY=
