# BiliSama 用到的环境变量。密钥永不入库：真正的值写进仓库根的 path.sh
# （已在 .gitignore 里），用之前 `source path.sh` 一下。
#
# 不必全填。只用云端语音服务的话，填第一段就能跑起来。

# --- 云端语音服务（dev-talk --provider dashscope）---
# export dashscope_url=...        # 阿里 MaaS 实例地址
# export ali_api_key=...          # 它的 key

# --- 本地引擎挂的对话模型（OpenAI 兼容的 chat-completions 端点）---
# export base_url=...
# export api_key=...
# export model_name=...

# --- 免 VPN 变体：本地引擎改挂阿里的兼容端点，见 runbook ---
# export openai_compatible_url=...
# export side_model_name=qwen3.7-flash   # 后台想话题和整理记忆用的模型，不填有默认值

# --- 服务端 TTS 音色，单次覆盖配置里的默认值（vivian）---
# export tts_speaker=serena

# --- 模型下载 ---
# 拉不动 HuggingFace 时换国内镜像（判停模型、合成模型走这里）：
# export HF_ENDPOINT=https://hf-mirror.com

# --- 路径类，都有默认值，一般不用设 ---
# export BILISAMA_S2S_ROOT=../speech-to-speech                     # 上游检出目录
# export BILISAMA_S2S_VENV=~/.local/share/bilisama/engines/s2s     # 引擎装在哪
# export BILISAMA_S2S_CONFIG=config/s2s/bilisama-s2s.json          # 起服务器用哪份配置

# --- 门禁 ---
# export BILISAMA_GATE_REQUIRE_INTEGRATION=1   # 没装 s2s 引擎就直接判失败，别跳过
# export BILISAMA_GATE_REQUIRE_UI=1            # 没装 playwright/chromium 就直接判失败

# --- 直播凭据 ---
# 连真直播间的登录态。不配也能连，但 B 站会把大部分观众的 uid 打码成 0、名字变 ***，
# 认不出常客也没法点名。配置里 [room] credential_ref = "env:BILI_SESSDATA" 指的就是它。
# export BILI_SESSDATA=<浏览器 cookie 里的 SESSDATA>

# --- 密钥的另一种写法 ---
# 配置里的 api_key_ref 写裸名（出厂就是 "dashscope" / "side" / "tts"）时，
# 解析顺序是先 BILISAMA_KEY_<大写名> 再 <原名>（secrets.py:37-40）。所以这两行等价：
# export BILISAMA_KEY_DASHSCOPE=...
# export dashscope=...
# 想明确一点就把 api_key_ref 改成 "env:某个变量名"，那样只读那一个变量。
# 今天只有环境变量这一个后端——系统钥匙串是跟 Electron 壳一起做的规划（计划 §6.5）。
